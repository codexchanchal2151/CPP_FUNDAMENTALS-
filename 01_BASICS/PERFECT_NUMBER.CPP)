#include <iostream>
using namespace std;

int main() {
    int num, sum = 0;

    cout << "Enter a positive integer: ";
    cin >> num;

    for (int i = 1; i <= num / 2; i++) {
        if (num % i == 0) {
            sum += i;
        }
    }

    if (sum == num && num > 0) {
        cout << num << " is a Perfect Number." << endl;
    } else {
        cout << num << " is NOT a Perfect Number." << endl;
    }

    return 0;
}
